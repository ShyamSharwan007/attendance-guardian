# Copy this file to .streamlit/secrets.toml (never commit the real file).
# On Streamlit Community Cloud, paste the same keys into App settings > Secrets.
# Every key is optional. A channel without credentials runs in DEMO MODE:
# nothing is sent and the app logs "would send" / "would call" instead.

# --- Gmail SMTP (SSL, port 465) -------------------------------------------
# Use a 16-character App Password (Google Account > Security > 2-Step
# Verification > App passwords), not your normal Gmail password.
GMAIL_USER = "your.name@gmail.com"
GMAIL_APP_PASSWORD = "abcd efgh ijkl mnop"
SENDER_NAME = "Attendance Guardian"

# --- Twilio voice calls ----------------------------------------------------
# Also accepted: TWILIO_SID, TWILIO_TOKEN, TWILIO_FROM / TWILIO_PHONE_NUMBER.
TWILIO_ACCOUNT_SID = "ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN = "your_auth_token"
TWILIO_FROM_NUMBER = "+15005550006"
# TWILIO_VOICE = "Polly.Aditi"        # Indian English voice
# DEFAULT_COUNTRY_CODE = "+91"        # used for 10-digit phone numbers

# --- Gemini (optional, personalised email text) ----------------------------
GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-2.5-flash"

# --- App ------------------------------------------------------------------
# Public URL of the deployed app, used for the "Book a slot" link in emails.
APP_URL = "https://your-app.streamlit.app"

# --- Safe demo overrides (recommended for hackathon demos) -----------------
# When set, EVERY email goes to TEST_EMAIL and EVERY call goes to TEST_PHONE,
# so you can demo live delivery without contacting the sample students.
# A Twilio trial account can only call verified numbers, so TEST_PHONE should
# be your verified number.
TEST_EMAIL = "your.name@gmail.com"
TEST_PHONE = "+919876543210"

# Force demo mode even when credentials are present.
# DEMO_MODE = "true"
